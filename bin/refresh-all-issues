#!/usr/bin/env node
import { default as debugInit } from '../lib/debug.js';
import refresh, { reportFailedRepos } from '../lib/refresh.js';
import db from '../lib/db.js';

debugInit('pulldasher:refresh*');

refresh.allIssues()
   .done(function (result) {
      reportFailedRepos(result);
      db.end();
   });
